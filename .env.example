# Copy to .env for Docker Compose (which reads it automatically). Keep real values out of Git.
# The backend runs on Convex and has its own environment variables (README.md).
NEXT_PUBLIC_CONVEX_URL=
# The matching Convex HTTP actions URL (*.convex.site), also set on Convex.
AUTH_ISSUER_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Docker publishes this port on the server; use 127.0.0.1 as APP_BIND_IP with Caddy.
APP_PORT=3000
APP_BIND_IP=0.0.0.0
# Public Docker server only; hostname without https:// (used by Caddy).
# APP_DOMAIN=app.example.com
# Generate an RSA private key and store its PEM as one-line base64:
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 | base64 -w0
AUTH_JWT_PRIVATE_KEY=
# Signup requires a name, email, and password. Password recovery is disabled.

# Convex backend only; set in the Convex dashboard or with `npx convex env set`.
# Never expose these as NEXT_PUBLIC_* or put them in browser code.
# HIKNOW_API_KEY=
# HIKNOW_BASE_URL=https://hiknow.ir/v1
# SOCIALAPI_API_KEY=
# X_API_CLIENT_ID=
# X_API_CLIENT_SECRET=
# X_API_BEARER_TOKEN=
# X_CONSUMER_SECRET=
# X_TOKEN_ENCRYPTION_KEY=
# AUTH_JWT_PUBLIC_JWK is the public half of AUTH_JWT_PRIVATE_KEY, set on Convex only.
# PROSPECTING_AUTO_RESCHEDULE=0
